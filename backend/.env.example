POSTGRES_DB=backend_db
POSTGRES_USER=backend_user
POSTGRES_PASSWORD=backend_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_LOCAL_PORT=5432
# Public mock accounts in the local development Compose environment only.
GUARDWORK_DEV_SEED_ENABLED=true
BACKEND_TEST_DATABASE_URL=
BACKEND_TEST_DATABASE_USER=
BACKEND_TEST_DATABASE_PASSWORD=
GUARDWORK_JWT_ACCESS_EXPIRATION_MS=
# Optional direct browser access only; Vite /api proxy needs no CORS allowlist.
# Example: http://localhost:5137,http://localhost:5138 (exact origins, no wildcard).
GUARDWORK_CORS_ALLOWED_ORIGINS=
# Reviewed legacy ownership commands additionally require GUARDWORK_OWNERSHIP_TOKEN.
# Read a short-lived access token interactively into the process environment;
# never save an actual token in this file, argv, evidence records, or logs.

# GW005 private invitation delivery via Resend HTTPS API (optional until invitations are used)
# Set a verified sender and secret-store-backed credential; never commit live values.
COMPANY_INVITATION_FROM=GuardWork <email address>
COMPANY_INVITATION_PROVIDER_CREDENTIAL=
# HTTPS frontend confirmation page, or HTTP on literal localhost for local testing.
# The secret appears only in its URL fragment.
# Local example: COMPANY_INVITATION_BASE_URL=http://localhost:5173/invitation
COMPANY_INVITATION_BASE_URL=
# Comma-separated exact origins (scheme, host, port), e.g. https://app.guardwork.vn.
# Local example: COMPANY_INVITATION_ALLOWED_ORIGINS=http://localhost:5173
# HTTP on IP addresses, subdomains of localhost, and other hosts is not allowed.
COMPANY_INVITATION_ALLOWED_ORIGINS=
COMPANY_INVITATION_CONNECT_TIMEOUT_SECONDS=
COMPANY_INVITATION_REQUEST_TIMEOUT_SECONDS=

# Scoped Company Membership outbox worker (milliseconds between batches of at most 100).
COMPANY_MEMBERSHIP_NOTIFICATIONS_WORKER_ENABLED=
COMPANY_MEMBERSHIP_NOTIFICATIONS_POLL_MS=

# Account email codes and Company decision delivery (Resend); SMS routes are retired.
ONBOARDING_EMAIL_FROM=
ONBOARDING_EMAIL_CREDENTIAL=
# Account codes need no confirmation URL. Invitation link settings above are unchanged.
# One-time GW-85 upgrade only: set true after contact/email preflight, then restore false.
# Required when the database already applied newer dev migrations; see README.md.
SPRING_FLYWAY_OUT_OF_ORDER=false
