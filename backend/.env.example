
POSTGRES_DB=database_name
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_HOST=host
POSTGRES_PORT=port

# JWT access-token lifetime in milliseconds (default: 15 minutes).
GUARDWORK_JWT_ACCESS_EXPIRATION_MS=900000

# Isolated local test database (docker-compose.test.yml; never use backend_db).
# This password is only for the disposable loopback-only test database.
BACKEND_TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/backend_test_db
# If changing this Compose host port, update BACKEND_TEST_DATABASE_URL to match.
BACKEND_TEST_DATABASE_PORT=55432
BACKEND_TEST_DATABASE_USER=backend_test
BACKEND_TEST_DATABASE_PASSWORD=backend-test-only

# Reviewed legacy ownership commands additionally require GUARDWORK_OWNERSHIP_TOKEN.
# Read a short-lived access token interactively into the process environment;
# never save an actual token in this file, argv, evidence records, or logs.

# GW005 private invitation delivery via Resend HTTPS API (optional until invitations are used)
# Set a verified sender and secret-store-backed credential; never commit live values.
COMPANY_INVITATION_FROM=
COMPANY_INVITATION_PROVIDER_CREDENTIAL=
# HTTPS frontend confirmation page; secret appears only in its URL fragment.
COMPANY_INVITATION_BASE_URL=
# Comma-separated exact HTTPS origins, e.g. https://app.guardwork.vn
COMPANY_INVITATION_ALLOWED_ORIGINS=
COMPANY_INVITATION_CONNECT_TIMEOUT_SECONDS=5
COMPANY_INVITATION_REQUEST_TIMEOUT_SECONDS=10

# Scoped Company Membership outbox worker (milliseconds between batches of at most 100).
COMPANY_MEMBERSHIP_NOTIFICATIONS_WORKER_ENABLED=true
COMPANY_MEMBERSHIP_NOTIFICATIONS_POLL_MS=30000
