# Register and log in to get a JWT access token
# Use a new username and email for each registration.
# For an existing account, set its email and password, then run only the login request.
# Copy data.accessToken from the login response and use it as:
# Authorization: Bearer <accessToken>
# Keep real credentials and tokens out of this file.

@baseUrl=http://localhost:8080
@username=gw_test_user_01
@email=gw-test-user-01@example.test
@password=LocalTestPass123
@adminUsernameOrEmail=gw_test_admin_01
@adminPassword=LocalTestPass123

# Register a test account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Minh",
  "lastName": "Nguyễn",
  "username": "{{username}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Log in and get a JWT access token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "{{email}}",
  "password": "{{password}}"
}

### Log in as an existing platform admin
# Regular registration creates USER accounts, not platform admins.
# Copy data.accessToken from the response for /api/admin requests.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "{{adminUsernameOrEmail}}",
  "password": "{{adminPassword}}"
}

### Current verification and capability state
# Set locally from the login response; keep real tokens out of tracked files.
@accessToken=replace-with-local-access-token
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}

### Explicitly request account email proof (never sent automatically at registration)
POST {{baseUrl}}/api/me/email-verification/request
Authorization: Bearer {{accessToken}}

### Enter the six-digit code from your own mailbox while signed in
# Copy only into your local request; never commit a real verification code.
@emailSecret=replace-with-six-digit-email-code
POST {{baseUrl}}/api/me/email-verification/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "emailSecret": "{{emailSecret}}"
}
