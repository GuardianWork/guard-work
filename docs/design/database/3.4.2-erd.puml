package "Identity and Candidate" {
entity users {
  * id : BIGSERIAL <<PK>>
  * username : VARCHAR(50) <<UK>>
  * email : VARCHAR(255) <<UK>>
}
entity refresh_tokens {
  * id : BIGSERIAL <<PK>>
  * user_id : BIGINT <<FK>>
  * token_hash : VARCHAR(64) <<UK>>
}
entity password_reset_tokens {
  * id : BIGSERIAL <<PK>>
  * user_id : BIGINT <<FK>>
  * token_hash : VARCHAR(64) <<UK>>
}
entity candidate_profiles {
  * id : UUID <<PK>>
  * user_id : BIGINT <<UK, FK>>
}
entity candidate_cvs {
  * id : UUID <<PK>>
  * candidate_id : UUID <<NO FK>>
}
}
package "Company access and audit" {
entity companies {
  * id : BIGSERIAL <<PK>>
  * tax_code : VARCHAR(50) <<UK>>
  verified_by : BIGINT <<FK>>
  owner_user_id : BIGINT <<FK>>
}
entity company_memberships {
  * id : BIGSERIAL <<PK>>
  * company_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  ended_by_user_id : BIGINT <<FK>>
}
entity company_invitations {
  * id : BIGSERIAL <<PK>>
  * company_id : BIGINT <<FK>>
  * invited_by_user_id : BIGINT <<FK>>
  * secret_hash : VARCHAR(64) <<UK>>
  accepted_by_user_id : BIGINT <<FK>>
  accepted_membership_id : BIGINT <<FK>>
  decided_by_user_id : BIGINT <<FK>>
}
entity company_ownership_reviews {
  * case_reference : VARCHAR(255) <<PK>>
  * company_id : BIGINT <<FK>>
  * applicant_user_id : BIGINT <<FK>>
  * reviewer_user_id : BIGINT <<FK>>
}
entity company_membership_audit_events {
  * id : BIGSERIAL <<PK>>
  * actor_user_id : BIGINT <<FK>>
  subject_user_id : BIGINT <<FK>>
  * company_id : BIGINT <<FK>>
  membership_id : BIGINT <<FK>>
  invitation_id : BIGINT <<FK>>
  reviewer_user_id : BIGINT <<FK>>
}
entity audit_logs {
  * id : BIGSERIAL <<PK>>
  * admin_id : BIGINT <<FK>>
}
}
package "Employer onboarding and verification" {
entity employer_registrations {
  * id : UUID <<PK>>
  promoted_user_id : BIGINT <<FK>>
}
entity employer_profiles {
  * user_id : BIGINT <<PK, FK>>
}
entity company_verification_documents {
  * id : UUID <<PK>>
  * uploader_id : BIGINT <<FK>>
}
entity company_verification_attempts {
  * id : UUID <<PK>>
  * company_id : BIGINT <<FK>>
  * submitter_id : BIGINT <<FK>>
  * document_id : UUID <<FK>>
  reviewer_id : BIGINT <<FK>>
}
entity company_decision_deliveries {
  * id : UUID <<PK, FK>>
}
}
package "Membership notifications" {
entity notification_outbox {
  * event_id : UUID <<PK>>
  * recipient_user_id : BIGINT <<FK>>
  * company_id : BIGINT <<FK>>
}
entity user_notifications {
  * id : BIGSERIAL <<PK>>
  * source_event_id : UUID <<UK, FK>>
  * recipient_user_id : BIGINT <<FK>>
  * company_id : BIGINT <<FK>>
}
}
