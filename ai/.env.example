# Copy to ai/.env.local; both run-local.sh commands load this configuration.
GUARDWORK_AI_ENABLED=true
GUARDWORK_AI_MODE=crawler
# Use the actual imported corpus identifier and change it after graph updates.
GUARDWORK_AI_LEGAL_SNAPSHOT=replace-with-imported-corpus-id
# Change profile when provider/model, prompts, retrieval or output behavior changes.
GUARDWORK_AI_PROFILE=jd-local-v4
# Optional override for the provider selected in crawler/.env (gemini or nvidia).
# LLM_BACKEND=gemini
# Credentials stay in crawler/.env or the process environment.
# A custom GUARDWORK_AI_SHARED_KEY can be configured here for both processes.
